# ----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt
.Python
develop-eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/

# Virtual environments
venv/
.venv/
env/
ENV/

# PyInstaller
*.manifest
*.spec

# Cython
cython_debug/

# ----------------------------------------------------------
# Node.js / Frontend
# ----------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
frontend/dist/
frontend/build/
.next/

# ----------------------------------------------------------
# Data (large files, not version-controlled)
# ----------------------------------------------------------
data/raw/
data/processed/
data/exports/

# ----------------------------------------------------------
# Generated Outputs
# ----------------------------------------------------------
outputs/

# ----------------------------------------------------------
# Jupyter Notebooks — checkpoints
# ----------------------------------------------------------
.ipynb_checkpoints/

